# ── Required ──────────────────────────────────────────────
# Groq API key — get yours free at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token with repo + pull_request scopes
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret you set when creating the GitHub webhook
# Used to verify requests really come from GitHub (any random string works)
GITHUB_WEBHOOK_SECRET=your_random_secret_here

# ── Optional ──────────────────────────────────────────────
# Restrict dashboard CORS origins (comma-separated). Leave as * for dev.
CORS_ORIGINS=*

# Port for local development (default: 8000)
PORT=8000
