# ── Required ──────────────────────────────────────────────
# Your Anthropic API key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token with repo + pull_request scopes
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret you set when creating the GitHub App webhook
# Used to verify requests really come from GitHub
GITHUB_WEBHOOK_SECRET=your_random_secret_here

# ── Optional ──────────────────────────────────────────────
# Port for local development (default: 8000)
PORT=8000
